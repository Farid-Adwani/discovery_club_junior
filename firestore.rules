rules_version = '2';

// The website never talks to Firestore directly: every read and write goes through
// our Express API (server/), which uses the Admin SDK and checks permissions itself.
// The Admin SDK bypasses these rules, so the browser is simply locked out.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

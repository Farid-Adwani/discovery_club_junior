rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'faridadwani2000@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection with RBAC
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Admins index
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Students / Waitlist collection
    match /students/{studentId} {
      // Anyone can create a waitlist application; signed in users can view and admin can manage
      allow create: if true;
      allow read: if true;
      allow update, delete: if isSignedIn();
    }

    // Cohort groups
    match /groups/{groupId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Programs
    match /programs/{programId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Sessions & Attendance
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Hoodie Merchandise Distributions & Orders
    match /hoodie_distributions/{distributionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // Hoodie Stock
    match /hoodie_stock/{size} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Material requests
    match /material_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // Competitions & Events
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

# ---- Server (server/) ----
# Comma-separated emails that get the admin role (required: empty means no admin at all).
# Their password is set from the terminal (at least 8 characters; this also signs out anyone who signed up
# with that email from the website before):
#   npm run set-password -- admin@example.com "a-strong-password"
ADMIN_EMAILS=""

# Port of the Node server (Vite proxies /api and /uploads to it in development)
PORT=8080

# Where the database (club.db) and the uploaded images (uploads/) are kept. Default: ./data
# Relative paths start from the project folder. Back this folder up, and never commit it.
DATA_DIR=""

# Address the server listens on. Default: 127.0.0.1 in production (only nginx can reach it), 0.0.0.0 in development
HOST=""

# Behind nginx on the VPS: "loopback", so wrong-password limits count each visitor's real address
# (nginx must send X-Forwarded-For, see DEPLOY.md). Leave empty when nothing is in front of the server.
TRUST_PROXY=""

# ---- Push notifications (Web Push, needs HTTPS) ----
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ---- One-time import from Firebase (npm run import:firebase) ----
# Path to the Firebase service-account key, or its whole JSON in FIREBASE_SERVICE_ACCOUNT_JSON.
# Not needed by the site itself: remove the key from the server once the import is done.
FIREBASE_SERVICE_ACCOUNT_PATH=""
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# FIREBASE_STORAGE_BUCKET=""   (default: <project-id>.firebasestorage.app)

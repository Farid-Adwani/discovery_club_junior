# ---- Backend (server/) ----
# Path to the Firebase service-account key (local development). Keep the file OUTSIDE git.
FIREBASE_SERVICE_ACCOUNT_PATH="../discovery-club-junior-firebase-adminsdk-xxxx.json"

# On hosts without files (Render, Railway…), paste the whole key JSON here instead:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Comma-separated emails that get the admin role (they must sign in with a verified email, e.g. Google)
ADMIN_EMAILS="faridadwani2000@gmail.com"

# Port for the API server (Vite proxies /api to it in development)
PORT=8080
